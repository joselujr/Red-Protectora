# This file includes global variables that will be available inside your project
# 1. In the front end code you can access this variables like this: console.log(import.meta.env.VARIABLE_NAME)
# 1. In the back end code you access the variable by importing os and then typing print(os.getenv('VARIABLE_NAME'))

# Back-End Variables
# Base de datos local de cada desarrollador (o Supabase).
# Supabase -> Connect: para la app en Vercel usar el "Transaction pooler" (puerto 6543);
# para flask db upgrade / pg_restore desde tu equipo usar el "Session pooler" (puerto 5432).
# Ejemplo: postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://gitpod:postgres@localhost:5432/example
FLASK_APP_KEY="any key works"
FLASK_APP=src/app.py
FLASK_DEBUG=1
DEBUG=TRUE
JWT_SECRET_KEY=required key
# Solo produccion: pon ALLOW_SEED=1 para habilitar temporalmente /api/seed (con FLASK_DEBUG=1 ya esta habilitado)
# ALLOW_SEED=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Front-End Variables
VITE_BASENAME=/
# URL del backend Flask en desarrollo (p.ej. http://localhost:3001). En Vercel se deja vacia: la API va en el mismo dominio.
#VITE_BACKEND_URL=
# URL pública del sitio, SIN barra final. La usan las etiquetas Open Graph del index.html.
# En local: la URL que da Codespaces con el puerto 3000 en visibilidad Public.
VITE_PUBLIC_URL=
